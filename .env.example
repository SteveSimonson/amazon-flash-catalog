# Copy to .dev.vars for local wrangler dev (never commit secrets)

SESSION_SECRET=generate-a-long-random-string
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Full-admin machine token (Authorization: Bearer …) for bootstrap/curl — root-equivalent
ADMIN_API_TOKEN=

# Optional — Amazon Creators API enrichment (falls back to scrape-only if missing/ineligible)
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
AMAZON_CREATORS_CREDENTIAL_VERSION=3.1
